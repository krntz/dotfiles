## APP CONSTANTS
set $BROWSER    firefox
set $MUSIC      spotify
set $TERMINAL   alacritty
set $LOCKER i3lock && sleep 1
set $SCREENSHOT_DIR $HOME/Pictures/screenshots

#set $LOCK       slock -m 'Locked at $(date "+%a %d, %H:%M:%s")'

#set $scripts    /home/ak/.scripts

## COLORS
# load colors from ~/.Xresources
set_from_resource $color0   color0  #000000
set_from_resource $color8   color8  #000000
set_from_resource $color1   color1  #000000
set_from_resource $color9   color9  #000000
set_from_resource $color2   color2  #000000
set_from_resource $color10  color10 #000000
set_from_resource $color3   color3  #000000
set_from_resource $color11  color11 #000000
set_from_resource $color4   color4  #000000
set_from_resource $color12  color12 #000000
set_from_resource $color5   color5  #000000
set_from_resource $color13  color13 #000000
set_from_resource $color6   color6  #000000
set_from_resource $color14  color14 #000000
set_from_resource $color7   color7  #000000
set_from_resource $color15  color15 #000000

# Property Name         Border      BG          Text    Indicator   Child Border
client.focused          $color7     $color4     $color0 $color8     $color4
client.focused_inactive $color7     $color0     $color7 $color8     $color7
client.unfocused        $color7     $color0     $color7 $color7    $color7
client.urgent           $color1     $color1     $color0 $color1     $color1
client.placeholder      $color0     $color0     $color7 $color0     $color0
client.background       $color15

## AUTOSTART SCRIPTS
# polybar
exec_always --no-startup-id $HOME/.config/polybar/launch.sh

# set correct keymap
exec --no-startup-id "setxkbmap se"

# make pointer disappear when not used
exec --no-startup-id unclutter

# start dunst
exec --no-startup-id dunst

# set wallpaper
#exec --no-startup-id xsetroot -solid "#333333"
exec --no-startup-id $HOME/.fehbg &

# picom
exec --no-startup-id picom --config $HOME/.config/picom/picom.conf -b

# turn off beep
exec --no-startup-id xset b off

# blank screen after 2 minutes
exec --no-startup-id xset s 120

# turn off screen after 1 hour
exec --no-startup-id xset dpms 3600

# lock computer
#exec --no-startup-id xss-lock --transfer-sleep-lock -- $LOCKER --nofork
#exec --no-startup-id xautolock -time 10 -locker $LOCKER -corners 000-

exec_always --no-startup-id autotiling

font pango:Overpass Nerd Font 14px

## WORKSPACES
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

## KEYMAPS
# set mod-key to super
set $mod Mod4
# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start terminal
bindsym $mod+Return exec $TERMINAL

# start BROWSER
bindsym $mod+w exec $BROWSER
#bindsym $mod+Control+w exec $scripts/rofi/rofi-web "$BROWSER --new-window"
#bindsym $mod+Shift+w exec $scripts/rofi/rofi-search "$BROWSER --new-window"

# start MUSIC
bindsym $mod+s exec $MUSIC
for_window [class="Spotify"] move container to workspace $ws10
for_window [class="Spotify"] fullscreen enable

# kill focused window
bindsym $mod+Shift+q kill

# start rofi
bindsym $mod+d exec rofi -modi drun -show drun

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# move workspace
bindsym $mod+Control+h move workspace to output left
bindsym $mod+Control+j move workspace to output down
bindsym $mod+Control+k move workspace to output up
bindsym $mod+Control+l move workspace to output right

# switch to workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# cycle open workspaces
bindsym $mod+Tab workspace next

# toggle splitting direction
bindsym $mod+t              split toggle

# enter fullscreen mode for the focused container
bindsym $mod+f              fullscreen toggle

# toggle tiling / floating
bindsym $mod+Shift+space    floating toggle

# change focus between tiling / floating windows
bindsym $mod+space          focus mode_toggle

# media keys
# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next

# rofi
#bindsym $mod+n  exec $scripts/rofi/rofi-now
#bindsym $mod+Shift+n exec $scripts/rofi/rofi-vol

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+F2             restart

# exit i3 (logs you out of your X session)
set $mode_system System (l) lock, (e) logout, (s) suspend, (h) hibernate, (r) reboot, (Shift+s) shutdown
mode "$mode_system" {
    bindsym l exec --no-startup-id $LOCKER, mode "default"
    bindsym e exec --no-startup-id i3-msg exit, mode "default"
    bindsym s exec --no-startup-id $LOCKER && systemctl suspend, mode "default"
    bindsym h exec --no-startup-id $LOCKER && systemctl hibernate, mode "default"
    bindsym r exec --no-startup-id systemctl reboot, mode "default"
    bindsym Shift+s exec --no-startup-id systemctl poweroff -i, mode "default"

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+Pause mode "$mode_system"

# resize containers
bindsym $mod+Shift+y exec $HOME/.config/i3/scripts/i3resize.sh left
bindsym $mod+Shift+u exec $HOME/.config/i3/scripts/i3resize.sh down
bindsym $mod+Shift+i exec $HOME/.config/i3/scripts/i3resize.sh up
bindsym $mod+Shift+o exec $HOME/.config/i3/scripts/i3resize.sh right

# screenshots
## files
bindsym Print exec --no-startup-id maim --format=png "$SCREENSHOT_DIR/$(date -u +'%Y%m%d-%T')-all.png" && notify-send "Screenshot saved to ~/Pictures/screenshots/$(date -u +'%Y%m%d-%T')-all.png"
bindsym $mod+Print exec --no-startup-id maim --format=png --window $(xdotool getactivewindow) "$SCREENSHOT_DIR/$(date -u +'%Y%m%d-%T')-current.png" && notify-send "Screenshot saved to ~/Pictures/screenshots/$(date -u +'%Y%m%d-%T')-current.png"
bindsym Shift+Print exec --no-startup-id maim --format=png --select "$SCREENSHOT_DIR/$(date -u +'%Y%m%d-%T')-selected.png" && notify-send "Screenshot saved to ~/Pictures/screenshots/$(date -u +'%Y%m%d-%T')-selected.png"

## clipboards
bindsym Ctrl+Print exec --no-startup-id maim --format=png | xclip -selection clipboard -t image/png && notify-send "Screenshot saved to clipboard"
bindsym Ctrl+$mod+Print exec --no-startup-id maim --format=png --window $(xdotool getactivewindow) | xclip -selection clipboard -t image/png && notify-send "Screenshot saved to clipboard"
bindsym Ctrl+Shift+Print exec --no-startup-id maim --format=png --select | xclip -selection clipboard -t image/png && notify-send "Screenshot saved to clipboard"

## MISC
# borders
title_align center
default_border normal
hide_edge_borders smart

# gaps
smart_gaps off
gaps inner 32
gaps outer 16

# force floating for some windows
for_window [window_role="Preferences"]  floating enable
for_window [window_role="pref"]         floating enable
for_window [window_role="About"]        floating enable
for_window [window_type="dialog"]       floating enable
for_window [window_type="menu"]         floating enable
for_window [window_role="About"]        floating enable
for_window [window_role="Organizer"]    floating enable
for_window [window_role="bubble"]       floating enable
for_window [window_role="page-info"]    floating enable
for_window [window_role="pop-up"]       floating enable
for_window [window_role="task_dialog"]  floating enable
for_window [window_role="toolbox"]      floating enable
for_window [window_role="webconsole"]   floating enable

focus_follows_mouse no
